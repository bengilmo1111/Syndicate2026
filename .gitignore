# Node and project files
node_modules/
# ...and as a bare name, so a symlink to a Playwright install elsewhere
# (which is how `tests/browser.mjs` gets run here) is ignored too. The
# trailing-slash form does not match a symlink.
node_modules
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
*.swp
*.swo

# IDE/editor
.vscode/
.idea/
*.code-workspace

# Build output
dist/
build/

# Python HTTP server logs / caches
__pycache__/
*.pyc

# Git artifacts
.git/

# Screenshots written by `node tests/browser.mjs --shots`
tests/shots/
